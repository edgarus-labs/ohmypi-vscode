{
  "name": "oh-my-pi",
  "displayName": "oh-my-pi",
  "description": "Native VS Code client for the oh-my-pi (OMP) coding agent runtime",
  "version": "0.6.0",
  "publisher": "oh-my-pi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/edgarus-labs/ohmypi-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/edgarus-labs/ohmypi-vscode/issues"
  },
  "homepage": "https://github.com/edgarus-labs/ohmypi-vscode#readme",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.106.0",
    "node": ">=22.12"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "OMP runs commands and edits files in the workspace, so it does not start in Restricted Mode. Trust the workspace to use OMP."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "OMP runs as a local process in the workspace folder, so it needs the folder on disk."
    }
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "omp-panel",
          "title": "OMP",
          "icon": "media/omp.svg"
        }
      ]
    },
    "views": {
      "omp-panel": [
        {
          "type": "webview",
          "id": "omp.chat",
          "name": "Chat"
        },
        {
          "id": "omp.agents",
          "name": "Agents",
          "visibility": "collapsed"
        },
        {
          "id": "omp.changes",
          "name": "Changes",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "omp.openConversation",
        "title": "Open in Side Bar",
        "category": "OMP",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "omp.addFileToChat",
        "title": "Add File to OMP Chat",
        "category": "OMP",
        "icon": "$(add)"
      },
      {
        "command": "omp.newSession",
        "title": "New Session",
        "category": "OMP",
        "icon": "$(add)"
      },
      {
        "command": "omp.resumeSession",
        "title": "Session History",
        "category": "OMP",
        "icon": "$(history)"
      },
      {
        "command": "omp.renameSession",
        "title": "Rename Session",
        "category": "OMP"
      },
      {
        "command": "omp.selectModel",
        "title": "Select Model",
        "category": "OMP"
      },
      {
        "command": "omp.selectThinkingLevel",
        "title": "Select Thinking Level",
        "category": "OMP"
      },
      {
        "command": "omp.toggleFastMode",
        "title": "Toggle Fast Mode",
        "category": "OMP",
        "icon": "$(zap)"
      },
      {
        "command": "omp.sendPrompt",
        "title": "Send Prompt",
        "category": "OMP"
      },
      {
        "command": "omp.showUsage",
        "title": "Show Usage",
        "category": "OMP",
        "icon": "$(dashboard)"
      },
      {
        "command": "omp.abort",
        "title": "Abort",
        "category": "OMP",
        "icon": "$(debug-stop)"
      },
      {
        "command": "omp.restart",
        "title": "Restart",
        "category": "OMP",
        "icon": "$(debug-restart)"
      },
      {
        "command": "omp.openSession",
        "title": "Open Session",
        "category": "OMP"
      },
      {
        "command": "omp.openSettings",
        "title": "Open Settings",
        "category": "OMP",
        "icon": "$(gear)"
      },
      {
        "command": "omp.showAgents",
        "title": "Show Agents",
        "category": "OMP"
      },
      {
        "command": "omp.showLog",
        "title": "Show Log",
        "category": "OMP"
      },
      {
        "command": "omp.agent.inspect",
        "title": "Inspect Agent",
        "category": "OMP",
        "icon": "$(info)"
      },
      {
        "command": "omp.agent.openTranscript",
        "title": "Open Agent Transcript",
        "category": "OMP",
        "icon": "$(go-to-file)"
      },
      {
        "command": "omp.agent.steer",
        "title": "Steer Agent",
        "category": "OMP",
        "icon": "$(comment)"
      },
      {
        "command": "omp.agent.cancel",
        "title": "Cancel Agent",
        "category": "OMP",
        "icon": "$(close)"
      },
      {
        "command": "omp.changes.openDiff",
        "title": "Open Diff",
        "category": "OMP",
        "icon": "$(diff)"
      },
      {
        "command": "omp.changes.openFile",
        "title": "Open File",
        "category": "OMP",
        "icon": "$(go-to-file)"
      },
      {
        "command": "omp.changes.clear",
        "title": "Clear Changes",
        "category": "OMP",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "omp.newSession",
          "when": "view =~ /^omp\\.chat/",
          "group": "navigation@1"
        },
        {
          "command": "omp.resumeSession",
          "when": "view =~ /^omp\\.chat/",
          "group": "navigation@2"
        },
        {
          "command": "omp.abort",
          "when": "view =~ /^omp\\.chat/ && omp.busy",
          "group": "navigation@3"
        },
        {
          "command": "omp.renameSession",
          "when": "view =~ /^omp\\.chat/",
          "group": "1_session@1"
        },
        {
          "command": "omp.openSession",
          "when": "view =~ /^omp\\.chat/",
          "group": "1_session@2"
        },
        {
          "command": "omp.restart",
          "when": "view =~ /^omp\\.chat/",
          "group": "1_session@3"
        },
        {
          "command": "omp.showLog",
          "when": "view =~ /^omp\\.chat/",
          "group": "2_settings@1"
        },
        {
          "command": "omp.openSettings",
          "when": "view =~ /^omp\\.chat/",
          "group": "2_settings@2"
        },
        {
          "command": "omp.changes.clear",
          "when": "view =~ /^omp\\.changes/",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "omp.agent.steer",
          "when": "view =~ /^omp\\.agents/ && viewItem == agent.running",
          "group": "inline@1"
        },
        {
          "command": "omp.agent.cancel",
          "when": "view =~ /^omp\\.agents/ && viewItem == agent.running",
          "group": "inline@2"
        },
        {
          "command": "omp.agent.openTranscript",
          "when": "view =~ /^omp\\.agents/ && viewItem =~ /^agent\\./",
          "group": "1_inspect@1"
        },
        {
          "command": "omp.agent.inspect",
          "when": "view =~ /^omp\\.agents/ && viewItem =~ /^agent\\./",
          "group": "1_inspect@2"
        },
        {
          "command": "omp.changes.openFile",
          "when": "view =~ /^omp\\.changes/ && viewItem == change",
          "group": "inline"
        }
      ],
      "explorer/context": [
        {
          "command": "omp.addFileToChat",
          "when": "resourceScheme == file || resourceScheme == vscode-remote",
          "group": "omp@1"
        }
      ],
      "editor/context": [
        {
          "command": "omp.addFileToChat",
          "when": "resourceScheme == file || resourceScheme == vscode-remote",
          "group": "omp@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "omp.addFileToChat",
          "when": "resourceScheme == file || resourceScheme == vscode-remote",
          "group": "omp@1"
        }
      ],
      "commandPalette": [
        {
          "command": "omp.selectThinkingLevel",
          "when": "omp.hasThinkingLevels"
        },
        {
          "command": "omp.agent.inspect",
          "when": "false"
        },
        {
          "command": "omp.agent.openTranscript",
          "when": "false"
        },
        {
          "command": "omp.agent.steer",
          "when": "false"
        },
        {
          "command": "omp.agent.cancel",
          "when": "false"
        },
        {
          "command": "omp.changes.openDiff",
          "when": "false"
        },
        {
          "command": "omp.changes.openFile",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "oh-my-pi",
      "properties": {
        "omp.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to the omp executable. Empty: search PATH and common install locations."
        },
        "omp.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "description": "Extra CLI arguments passed to `omp --mode rpc-ui` (for example `--profile work`). Model, provider and approval configuration stay in OMP."
        },
        "omp.startup": {
          "type": "string",
          "enum": [
            "resumeLast",
            "newSession",
            "manual"
          ],
          "default": "resumeLast",
          "description": "On activation: resume the last session of this workspace, start a fresh one, or wait until a command is run."
        },
        "omp.autoRestart": {
          "type": "boolean",
          "default": true,
          "description": "Restart the OMP process after an unexpected exit (bounded retries)."
        },
        "omp.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "default": "info",
          "description": "Verbosity of the oh-my-pi output channel."
        },
        "omp.traceRpc": {
          "type": "boolean",
          "default": false,
          "description": "Log every RPC frame (abbreviated; answers to input requests redacted) to the output channel."
        },
        "omp.includeEditorContext": {
          "type": "boolean",
          "default": true,
          "description": "Default state of the composer's 'attach editor context' toggle (active file, selection, diagnostics)."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "omp.agents",
        "contents": "No agents yet."
      },
      {
        "view": "omp.changes",
        "contents": "No changes yet. Files edited by OMP appear here."
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p src/shared && tsc -p . && tsc -p src/webview && tsc -p test",
    "test:unit": "node esbuild.mjs --tests && mocha --node-option max-old-space-size=1536 --timeout 20000 \"out/test/unit/**/*.test.js\"",
    "test:integration": "node esbuild.mjs && node esbuild.mjs --tests && node out/test/runIntegration.js",
    "test:integration:min": "node esbuild.mjs && node esbuild.mjs --tests && node out/test/runIntegration.js --vscode-version=min",
    "test": "npm run typecheck && npm run test:unit && npm run test:integration",
    "test:real": "node esbuild.mjs && node esbuild.mjs --tests && node out/test/runIntegration.js --real",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "node -e \"require('fs').mkdirSync('dist-vsix',{recursive:true})\" && vsce package --no-dependencies -o dist-vsix/oh-my-pi.vsix",
    "lint": "biome lint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.106.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "linkedom": "^0.18.13",
    "mocha": "^12.0.3",
    "mocha-host": "npm:mocha@^11.8.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.1.2"
  }
}
